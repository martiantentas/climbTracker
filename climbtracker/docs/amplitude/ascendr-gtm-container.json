            "key": "html",
            "value": "<script>\n(function () {\n  var ev = {{Event}};\n  var payload = {};\n  try { payload = JSON.parse({{DLV - amp_payload}} || '{}'); } catch (e) { return; }\n  var tries = 0;\n\n  function send(a) {\n    if (ev === 'amplitude_event' && payload.name) {\n      a.track(payload.name, payload.props || {}, payload.insertId ? { insert_id: payload.insertId } : undefined);\n    } else if (ev === 'amplitude_identify' && payload.userId) {\n      a.setUserId(payload.userId);\n      var id = new a.Identify();\n      var props = payload.props || {};\n      Object.keys(props).forEach(function (k) { id.set(k, props[k]); });\n      a.identify(id);\n    } else if (ev === 'amplitude_reset') {\n      a.reset();\n    }\n  }\n\n  // Amplitude may still be loading: wait up to 5 seconds.\n  (function wait() {\n    var a = window.amplitude;\n    if (a && a.track) return send(a);\n    if (++tries < 20) setTimeout(wait, 250);\n  })();\n})();\n</script>"
