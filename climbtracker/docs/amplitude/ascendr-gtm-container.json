        "parameter": [
          {
            "type": "TEMPLATE",
            "key": "html",
            "value": "<script>\n(function () {\n  var key = {{Amplitude API key}};\n  // Safety: do nothing until a real 32-character project key is in the lookup variable.\n  if (!/^[0-9a-f]{32}$/.test(key)) { console.warn('[Amplitude] API key not set, tracking disabled'); return; }\n  if (window.__ascendrAmplitudeLoading) return;\n  window.__ascendrAmplitudeLoading = true;\n\n  // The analytics library only, pinned to one version and checked with a hash.\n  // Do NOT use the project's install snippet (cdn.eu.amplitude.com/script/KEY.js):\n  // it also loads Session Replay and asks Amplitude for remote settings.\n  // To upgrade: change the version here and the hash (see the guide, section 7).\n  var s = document.createElement('script');\n  s.async = true;\n  s.crossOrigin = 'anonymous';\n  s.integrity = 'sha384-lKBFu+lrE+l3rHaNqttqd3e3ga1kwCKyeO1JiVVq2NlrrkHTdt8SobN3bqqLSKSw';\n  s.src = 'https://cdn.eu.amplitude.com/libs/analytics-browser-2.42.4-min.js.gz';   // EU host: same file, same hash\n  s.onload = function () {\n    window.amplitude.init(key, {\n      serverZone: 'EU',                            // EU data region: needs an EU project key\n      autocapture: false,                          // only the events in the tracking plan\n      fetchRemoteConfig: false,                    // the code, not the Amplitude UI, decides the settings\n      remoteConfig: { fetchRemoteConfig: false }\n    });\n    window.amplitude.setOptOut(false);\n  };\n  document.head.appendChild(s);\n})();\n</script>"
